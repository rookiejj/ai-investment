# Briefick Terminal — 환경변수 예시. 복사해서 .env 로 사용.
#   cp trading/.env.example trading/.env
#
# ── 서버(프록시) ──────────────────────────────────────────────
# 기본 시세(Yahoo Finance)는 키가 필요 없습니다. 서버는 비밀 키 없이 동작합니다.
PORT=8080

# ── (선택) 추가 데이터 제공자 — 서버측 프록시를 확장할 때만 ──────
# 미국 주식 원문 뉴스 / 옵션 체인 / SEC·DART 등 고급 데이터는 키가 필요합니다.
# 아래 값은 현재 미사용(스캐폴드). 연동 시 server.js 에 라우트를 추가하세요. README 참조.
# FINNHUB_API_KEY=
# MARKETAUX_API_KEY=
# POLYGON_API_KEY=
# ALPHAVANTAGE_API_KEY=
# SEC_USER_AGENT="your-app your-email@example.com"   # SEC EDGAR 요구 UA
# DART_API_KEY=                                       # 한국 전자공시 OpenDART

# ── ⚠ 클라이언트 측 비밀(여기 두지 않음) ─────────────────────────
# Gemini API 키, 브로커(Alpaca/IBKR/한국투자) 키는 서버가 아니라
# 브라우저 [설정] 패널에 입력 → 그 브라우저 localStorage 에만 저장됩니다.
# 깃·서버에 절대 커밋하지 마세요. 보안 주의는 README "로그인/보안 설계" 참조.
